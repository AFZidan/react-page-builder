{
  "name": "@ahmedzidan/react-page-builder",
  "version": "1.0.13",
  "description": "A visual drag-and-drop page builder for React with support for custom components, responsive design, and advanced styling",
  "main": "./dist/page-builder.cjs",
  "module": "./dist/page-builder.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/page-builder.es.js",
      "require": "./dist/page-builder.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src --max-warnings 50",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "changelog": "bash scripts/generate-changelog.sh",
    "release:preview": "node scripts/preview-release-notes.js",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build",
    "version": "git add package.json",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "page-builder",
    "visual-editor",
    "drag-and-drop",
    "react",
    "wysiwyg",
    "website-builder",
    "cms",
    "responsive-design",
    "bootstrap-grid",
    "component-library"
  ],
  "author": "Ahmed Zidan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AFZidan/react-page-builder.git"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "daisyui": {
      "optional": true
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "lucide-react": "^1.20.0",
    "react-colorful": "^5.7.0",
    "react-hook-form": "^7.79.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "terser": "^5.48.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
